# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Darb Database & Backend Configuration
DATABASE_URL=
DATABASE_SSL=false
SESSION_SECRET=
ADMIN_EMAILS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
PAYMENT_PROVIDER_1_KEY=
PAYMENT_PROVIDER_1_SECRET=
PAYMENT_PROVIDER_2_KEY=
PAYMENT_PROVIDER_2_SECRET=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_MEDIATOR_URL=
PAYMENT_MEDIATOR_KEY=

# DARB V1.12 — External Web Search (Server-side only)
WEB_SEARCH_BASE_URL=
WEB_SEARCH_API_KEY=
WEB_SEARCH_ENGINE=generic

# DARB V1.13 — Trusted Web Search + Cache (Server-side only)
WEB_SEARCH_CACHE_TTL_SECONDS=900
WEB_SEARCH_MAX_RESULTS=10
WEB_SEARCH_TRUSTED_DOMAINS=gov.eg,gov.sa,gov.ae,gov.qa,gov.kw,gov.bh,gov.om,gov.jo,gov.ps,absher.sa,qiwa.sa,mofa.gov.sa,digital.gov.eg,mfa.gov.eg,icp.gov.ae,u.ae

# DARB V1.14 — AI Answer Engine (Server-side only)
AI_ANSWER_MIN_SUPPORT=1
AI_ANSWER_MAX_SOURCES=5
AI_ANSWER_MAX_ANSWER_CHARS=4000

# DARB V1.15 — AI Quality & Knowledge Governance (Server-side only)
AI_QUALITY_FEEDBACK_ENABLED=true
AI_QUALITY_MAX_REVIEW_ITEMS=200
AI_KNOWLEDGE_CANDIDATE_AUTO_PUBLISH=false

# DARB V1.16 — AI Monitoring & Freshness (Server-side only)
AI_MONITORING_ENABLED=true
AI_MONITOR_REPEATED_THRESHOLD=5
AI_MONITOR_SOURCE_MAX_AGE_DAYS=30
AI_MONITOR_MAX_EVENTS=500
AI_MONITOR_AUTO_PUBLISH=false

# DARB V1.17 — AI Learning & Knowledge Evolution (Server-side only)
AI_LEARNING_ENABLED=true
AI_LEARNING_AUTO_PUBLISH=false
AI_LEARNING_STALE_SOURCE_DAYS=90

# DARB V1.18 — AI Orchestrator (Server-side only)
AI_ORCHESTRATOR_ENABLED=true
AI_ORCHESTRATOR_KNOWLEDGE_FIRST=true
AI_ORCHESTRATOR_REQUIRE_WEB_CONSENT=true
AI_ORCHESTRATOR_MAX_STEPS=12
AI_ORCHESTRATOR_AUTO_PUBLISH=false

# DARB V1.19 — AI Security & Cost Guard (Server-side only)
AI_RATE_LIMIT_PER_WINDOW=30
AI_RATE_LIMIT_WINDOW_SECONDS=60
AI_DAILY_REQUEST_LIMIT=1000
AI_DAILY_TOKEN_BUDGET=500000
AI_REQUEST_TIMEOUT_MS=15000
AI_DUPLICATE_SUPPRESSION_SECONDS=20
AI_EXTERNAL_EVIDENCE_MAX_CHARS=12000
AI_SECURITY_GUARD_ENABLED=true
AI_SECURITY_LOG_ENABLED=true
AI_AUTO_PUBLISH=false

# DARB V1.20 — AI Production Resilience & Privacy Guard (Server-side only)
AI_CIRCUIT_BREAKER_ENABLED=true
AI_CIRCUIT_FAILURE_THRESHOLD=5
AI_CIRCUIT_RESET_TIMEOUT_MS=30000
AI_CIRCUIT_HALF_OPEN_SUCCESSES=2
AI_RETRY_MAX_ATTEMPTS=3
AI_RETRY_INITIAL_DELAY_MS=500
AI_RETRY_MAX_DELAY_MS=4000
AI_RETRY_BACKOFF_FACTOR=2.0
AI_RETRY_JITTER_RATIO=0.2
AI_PRIVACY_LOG_REDACT=true
AI_RESILIENCE_HEALTH_CACHE_SEC=10

# DARB V1.21 — AI Evaluation & Automated Test Lab (Server-side only)
AI_EVAL_ENABLED=true
AI_EVAL_MAX_CASES_PER_RUN=100
AI_EVAL_TIMEOUT_MS=20000
AI_EVAL_STORE_ANSWERS=false
AI_EVAL_AUTO_PUBLISH=false

# DARB V1.22 — AI Knowledge Quality & Refresh Manager (Server-side only)
AI_KNOWLEDGE_REFRESH_ENABLED=true
AI_KNOWLEDGE_AGING_DAYS=30
AI_KNOWLEDGE_STALE_DAYS=90
AI_KNOWLEDGE_AUTO_PUBLISH=false

# DARB V1.23 — AI Evaluation Integrated Runner (Server-side only)
AI_EVALUATION_RUNNER_ENABLED=true
AI_EVALUATION_DEFAULT_MODE=dry_run
AI_EVALUATION_INTEGRATION_ALLOW_KNOWLEDGE_WRITE=false
AI_EVALUATION_MAX_CASES_PER_RUN=500
AI_EVALUATION_STORE_OBSERVATIONS=true

# DARB V1.24 — AI Regression & Release Gate (Server-side only)
AI_REGRESSION_GATE_ENABLED=true
AI_REGRESSION_MIN_PASS_RATE_DROP=0.02
AI_REGRESSION_MAX_LATENCY_INCREASE_RATIO=0.25
AI_REGRESSION_MAX_TOKEN_INCREASE_RATIO=0.25
AI_RELEASE_GATE_AUTO_PUBLISH=false
AI_RELEASE_GATE_REQUIRE_HUMAN_DECISION=true

# DARB V1.25 — AI Release & Version Manager (Server-side only)
AI_RELEASE_VERSION_MANAGER_ENABLED=true
AI_RELEASE_AUTO_PUBLISH=false
AI_RELEASE_REQUIRE_HUMAN_ACTIVATION=true
AI_RELEASE_REQUIRE_PASS_GATE_FOR_ACTIVATION=true
AI_RELEASE_ROLLBACK_REQUIRE_HUMAN_CONFIRMATION=true
AI_RELEASE_SNAPSHOT_CHECKSUM=sha256

# DARB V1.26 — AI Deployment & Environment Manager (Server-side only)
AI_DEPLOYMENT_ENVIRONMENT_MANAGER_ENABLED=true
AI_DEPLOYMENT_AUTO_DEPLOY=false
AI_DEPLOYMENT_REQUIRE_HUMAN_APPROVAL=true
AI_DEPLOYMENT_PRODUCTION_REQUIRE_PASS_GATE=true
AI_DEPLOYMENT_STAGING_REQUIRE_PASS_GATE=true
AI_DEPLOYMENT_ROLLBACK_REQUIRE_REASON=true
AI_DEPLOYMENT_CONFIG_CHECKSUM=sha256

# DARB V1.27 — AI Observability & SLO Manager (Server-side only)
AI_OBSERVABILITY_ENABLED=true
AI_OBSERVABILITY_DEFAULT_WINDOW_MINUTES=60
AI_OBSERVABILITY_AUTO_REMEDIATION=false
AI_OBSERVABILITY_AUTO_ROLLBACK=false
AI_OBSERVABILITY_AUTO_DEPLOY=false
AI_OBSERVABILITY_P95_LATENCY_TARGET_MS=3000
AI_OBSERVABILITY_ERROR_RATE_TARGET=0.05
AI_OBSERVABILITY_PROVIDER_FAILURE_TARGET=0.10
AI_OBSERVABILITY_HELPFUL_RATE_TARGET=0.80

# DARB V1.28 — AI Incident & Recovery Manager (Server-side only)
AI_INCIDENT_RECOVERY_ENABLED=true
AI_INCIDENT_HUMAN_APPROVAL_REQUIRED=true
AI_INCIDENT_AUTO_REMEDIATION=false
AI_INCIDENT_AUTO_ROLLBACK=false
AI_INCIDENT_AUTO_DEPLOY=false
AI_INCIDENT_DEFAULT_ENVIRONMENT=production

# DARB AI V1.29 — Capacity & Cost Governance (Server-side only)
AI_CAPACITY_COST_ENABLED=true
AI_CAPACITY_COST_AUTO_REMEDIATION=false
AI_CAPACITY_COST_AUTO_ROLLBACK=false
AI_CAPACITY_COST_AUTO_DEPLOY=false
AI_CAPACITY_COST_AUTO_SCALING=false
AI_CAPACITY_COST_HUMAN_APPROVAL_REQUIRED=true
AI_CAPACITY_COST_DEFAULT_BUDGET_PERIOD=monthly
AI_CAPACITY_COST_WARNING_PERCENT=80
AI_CAPACITY_COST_CRITICAL_PERCENT=100
AI_CAPACITY_COST_FORECAST_PERIODS=3

# DARB AI V1.30 — Optimization Governance (Server-side only)
AI_OPTIMIZATION_ENABLED=true
AI_OPTIMIZATION_AUTO_REMEDIATION=false
AI_OPTIMIZATION_AUTO_ROLLBACK=false
AI_OPTIMIZATION_AUTO_DEPLOY=false
AI_OPTIMIZATION_AUTO_SCALING=false
AI_OPTIMIZATION_AUTO_APPLY=false
AI_OPTIMIZATION_HUMAN_APPROVAL_REQUIRED=true
AI_OPTIMIZATION_DEFAULT_SAVINGS_TARGET_PERCENT=10

# DARB AI V1.30 — Final Production Audit Pack Environment Variables
AI_CAPACITY_AUTO_REMEDIATION=false
AI_CAPACITY_AUTO_ROLLBACK=false
AI_CAPACITY_AUTO_DEPLOY=false
AI_CAPACITY_AUTO_SCALING=false
AI_AUTO_OPTIMIZATION_APPLY=false
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# DARB Global Knowledge Engine V1
DARB_KNOWLEDGE_ENGINE_ENABLED=true
DARB_KNOWLEDGE_AUTO_PUBLISH=false
DARB_KNOWLEDGE_REQUIRE_REVIEW=true
DARB_KNOWLEDGE_STALE_DAYS=90
DARB_KNOWLEDGE_AGING_DAYS=30
DARB_KNOWLEDGE_MAX_FACTS_PER_QUERY=100

# DARB Global Knowledge Engine V1.1 — Populate & Verify
DARB_GKE_AUTO_PUBLISH=false
DARB_GKE_REQUIRE_HUMAN_REVIEW=true
DARB_GKE_STALE_LIVE_DATA_BLOCK=true
DARB_GKE_REFERENCE_DATA_AS_LIVE=false
